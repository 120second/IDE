LIGHTCP_ENVIRONMENT=development
LIGHTCP_DATABASE_URL=sqlite:///./data/lightcp.db
LIGHTCP_JWT_SECRET_KEY=replace-with-at-least-32-random-characters
LIGHTCP_JWT_ISSUER=lightcp-server
LIGHTCP_JWT_AUDIENCE=lightcp-client
LIGHTCP_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LIGHTCP_RESET_CODE_SECRET=replace-with-a-separate-random-secret
LIGHTCP_RESET_CODE_EXPIRE_MINUTES=10
LIGHTCP_SMTP_HOST=
LIGHTCP_SMTP_PORT=587
LIGHTCP_SMTP_USERNAME=
LIGHTCP_SMTP_PASSWORD=
LIGHTCP_SMTP_FROM_EMAIL=
LIGHTCP_SMTP_USE_TLS=true

