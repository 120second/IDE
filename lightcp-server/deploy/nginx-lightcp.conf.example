# Add this location only to the selected LightCP HTTPS server block.
# A dedicated public prefix avoids colliding with another app that already
# owns /api/. The trailing slashes rewrite /lightcp-api/* to /api/* upstream.
location /lightcp-api/ {
    proxy_pass http://127.0.0.1:8100/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 2m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
}
