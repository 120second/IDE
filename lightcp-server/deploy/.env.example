# Install as /etc/lightcp-server.env with owner root:lightcp and mode 0640.
LIGHTCP_ENVIRONMENT=production
LIGHTCP_DATABASE_URL=sqlite:////var/lib/lightcp-server/lightcp.db

# Replace both placeholders with different random values before first start.
# Suggested command for each value: openssl rand -hex 32
LIGHTCP_JWT_SECRET_KEY=replace-with-a-random-jwt-secret-of-at-least-32-characters
LIGHTCP_JWT_ISSUER=lightcp-server
LIGHTCP_JWT_AUDIENCE=lightcp-client
LIGHTCP_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LIGHTCP_RESET_CODE_SECRET=replace-with-a-different-random-reset-secret
LIGHTCP_RESET_CODE_EXPIRE_MINUTES=10

# SMTP is optional for the first deployment. With these values empty, all
# APIs except forgot-password email delivery remain available.
LIGHTCP_SMTP_HOST=
LIGHTCP_SMTP_PORT=587
LIGHTCP_SMTP_USERNAME=
LIGHTCP_SMTP_PASSWORD=
LIGHTCP_SMTP_FROM_EMAIL=
LIGHTCP_SMTP_USE_TLS=true
